{
  "name": "tabbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/tests/*.test.js",
    "auth:secret": "node server/scripts/create-jwt-secret.js",
    "db:setup": "node server/scripts/setup-database.js",
    "test:integration": "node --test server/integration/*.test.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.0.0",
    "supertest": "^7.0.0",
    "vite": "^8.2.2"
  }
}
