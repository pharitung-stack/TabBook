# Use your own Atlas connection string, or a local MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/TabBook_DB
# Explicit database selection also works when the Atlas URI has no database path.
MONGODB_DB=TabBook_DB
# Generate once with npm run auth:secret. Keep the same value between restarts.
JWT_SECRET=
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
